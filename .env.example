# ─────────────────────────────────────────────────────────────────
# Pulso Cultural — required environment variables
# Copy to .env and fill in REAL values. Never commit .env.
# Generate strong secrets with: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────

# Postgres (used by docker-compose)
POSTGRES_USER=pulso
POSTGRES_PASSWORD=changeme_strong_pw
POSTGRES_DB=pulsocultural

# API
NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://pulso:changeme_strong_pw@postgres:5432/pulsocultural

# Auth & crypto — minimum 32 chars (16 for the two salts).
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_openssl_rand_base64_48
CPF_SALT=replace_with_16+_random_bytes
EMAIL_SALT=replace_with_different_16+_random_bytes

# Initial admin (used only on first boot to create the admin row).
# After the row exists, this var can be removed.
ADMIN_EMAIL=admin@mam.ba.gov.br
ADMIN_PASSWORD=set_a_real_password_here

# CORS — comma-separated. Add your production origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
WEB_URL=http://localhost:5173

# Single source of truth for the museum slug used in this deploy.
PILOT_MUSEUM_SLUG=mam-bahia

# Camera ingest (optional). Without it, /camera/counts/ingest returns 503.
# CAMERA_SECRET=

# SMTP for invite emails (optional). Without these, invite links are logged
# and shown in the dashboard so the admin can copy them manually.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Pulso Cultural <noreply@example.com>

# QA only — never set in production.
# ALLOW_FAKE_CPF=1

# Web
VITE_API_URL=http://localhost:3333
