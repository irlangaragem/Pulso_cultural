# =============================================================
# .env.example — Copie para .env e ajuste
# =============================================================

# ── Câmera ────────────────────────────────────────────────────
CAMERA_SOURCE=0           # 0 = câmera padrão | 1 = USB | rtsp://...
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# ── Modelo YOLOv8 ─────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt     # nano = rápido | yolov8s.pt = melhor precisão
CONFIDENCE=0.45
DEVICE=cpu                # cpu | cuda | mps (Apple Silicon)

# ── Linha virtual de contagem (coordenadas 0..1) ───────────────
# Linha horizontal no meio do frame (entrada pela metade inferior):
LINE_START_X=0.0
LINE_START_Y=0.5
LINE_END_X=1.0
LINE_END_Y=0.5

# ── API Pulso Cultural ────────────────────────────────────────
API_BASE_URL=https://pulso-api-backend-production.up.railway.app
CAMERA_API_KEY=          # gerado no dashboard → Câmeras
CAMERA_ID=               # ID da câmera cadastrada
EXHIBITION_ID=           # ID da exposição ativa (opcional)

# Intervalo de envio para a API (segundos)
SEND_INTERVAL=60

# ── Debug ──────────────────────────────────────────────────────
SHOW_WINDOW=true         # false para rodar headless (servidor)
SHOW_OVERLAY=true        # false para não desenhar boxes

# ── SQLite local ───────────────────────────────────────────────
SQLITE_DB=counts.db
